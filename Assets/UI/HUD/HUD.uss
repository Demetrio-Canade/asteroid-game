/*
 * HUD — ciò che è solo suo.
 *
 * Il riquadro del terminale, le righe e la palette stanno in Terminal.uss, che
 * HUD.uxml carica prima di questo: qui ci sono le barre, il mirino e le soglie
 * di colore, che nessun'altra schermata usa.
 *
 * Le soglie sono classi (is-warn, is-critical, is-blocked) che il codice accende
 * e spegne: i colori non compaiono mai in C#.
 */

/* ---------- radice ---------- */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- i pannelli negli angoli ---------- */

/*
 * Un blocco per dato, ciascuno nel suo angolo: leggerne uno non obbliga a
 * scandire gli altri. Il riquadro e la palette vengono da Terminal.uss — qui
 * c'è solo dove sta ciascuno e come è fatto dentro.
 */

.panel {
    position: absolute;
}

.panel--score {
    left: 24px;
    top: 24px;
}

.panel--time {
    top: 24px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}

.panel--difficulty {
    top: 24px;
    right: 24px;
}

/*
 * L'integrità sta in basso a sinistra: fuori dalla zona in cui si spara, ma
 * dentro il campo visivo periferico. È il dato che non si deve leggere.
 */
.panel--integrity {
    left: 24px;
    bottom: 24px;
}

.panel__label {
    color: rgb(47, 143, 87);
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.panel__value {
    color: rgb(182, 255, 207);
    font-size: 22px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.panel__value--inline {
    font-size: 15px;
    margin-left: 10px;
}

.gauge-row {
    flex-direction: row;
    align-items: center;
}

/* ---------- i segmenti ---------- */

/*
 * Cinque blocchi che si spengono uno alla volta. Cinque punti di scafo e cinque
 * livelli di minaccia sono quantità piccole e intere: contarle a colpo d'occhio
 * è più veloce che interpretare quanto è piena una barra.
 */

.pips {
    flex-direction: row;
    align-items: center;
}

.pip {
    width: 16px;
    height: 10px;
    margin-right: 4px;
    background-color: rgba(74, 222, 128, 0.14);
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.35);
}

.pip.is-on {
    background-color: rgb(74, 222, 128);
}

/* ---------- soglie ---------- */

.panel.is-warn .panel__value {
    color: rgb(255, 176, 32);
}

.panel.is-warn .pip.is-on {
    background-color: rgb(255, 176, 32);
}

.panel.is-critical .panel__value {
    color: rgb(255, 77, 77);
}

.panel.is-critical .pip.is-on {
    background-color: rgb(255, 77, 77);
}

/* ---------- il mirino ---------- */

/*
 * Il wrapper è il punto di mira e nient'altro: niente dimensioni, così i due
 * reticoli possono essere grandi quanto vogliono restando centrati sullo stesso
 * punto. È l'unico elemento che il codice sposta.
 */
.crosshair {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.reticle {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
}

.reticle--machinegun {
    width: 26px;
    height: 26px;
}

.reticle--cannon {
    width: 40px;
    height: 40px;
}

/* Uno alla volta. Logics dice quale arma, la scelta del reticolo sta qui. */

.crosshair .reticle--cannon {
    display: none;
}

.crosshair.is-cannon .reticle--machinegun {
    display: none;
}

.crosshair.is-cannon .reticle--cannon {
    display: flex;
}

/* ---------- le parti di un reticolo ---------- */

.reticle__ring {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-color: rgb(74, 222, 128);
    border-radius: 20px;
}

.reticle__tick {
    position: absolute;
    background-color: rgb(74, 222, 128);
}

.reticle__tick--top,
.reticle__tick--bottom {
    left: 50%;
    width: 2px;
    height: 7px;
    translate: -50% 0;
}

.reticle__tick--left,
.reticle__tick--right {
    top: 50%;
    width: 7px;
    height: 2px;
    translate: 0 -50%;
}

/* Mitraglietta: le tacche stanno sul bordo del riquadro. */

.reticle--machinegun .reticle__tick--top {
    top: 0;
}

.reticle--machinegun .reticle__tick--bottom {
    bottom: 0;
}

.reticle--machinegun .reticle__tick--left {
    left: 0;
}

.reticle--machinegun .reticle__tick--right {
    right: 0;
}

/* Cannone: stanno fuori dall'anello, staccate di 2px. */

.reticle--cannon .reticle__tick--top {
    top: -9px;
}

.reticle--cannon .reticle__tick--bottom {
    bottom: -9px;
}

.reticle--cannon .reticle__tick--left {
    left: -9px;
}

.reticle--cannon .reticle__tick--right {
    right: -9px;
}

.reticle__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 3px;
    background-color: rgb(182, 255, 207);
    translate: -50% -50%;
}

/* ---------- le barre dell'arma ---------- */

/*
 * Due barre verticali ai lati del mirino, che lo seguono: a sinistra il calore
 * della mitraglietta, a destra la carica del cannone. Stanno fuori dalle tacche
 * del reticolo del cannone, che è il più largo dei due.
 *
 * Compaiono solo quando hanno qualcosa da dire — calore sopra zero, cannone in
 * ricarica — e lo fanno in dissolvenza: a riposo il mirino resta pulito.
 */
.gauge {
    position: absolute;
    top: 0;
    width: 4px;
    height: 34px;
    translate: -50% -50%;
    background-color: rgba(74, 222, 128, 0.14);
    border-width: 1px;
    border-color: rgba(74, 222, 128, 0.35);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.gauge--heat {
    left: -36px;
}

.gauge--charge {
    left: 36px;
}

.crosshair.is-heating .gauge--heat,
.crosshair.is-charging .gauge--charge {
    opacity: 1;
}

/* Si riempiono dal basso: il codice scrive l'altezza, non la larghezza. */
.gauge__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgb(74, 222, 128);
}

/* Il calore segue la scala di gravità di sempre: ambra vicino al blocco, rosso bloccata. */

.gauge.is-warn .gauge__fill {
    background-color: rgb(255, 176, 32);
}

.gauge.is-critical .gauge__fill {
    background-color: rgb(255, 77, 77);
}

/* La carica è ambra mentre recupera: quando è piena la barra se ne va. */

.gauge--charge .gauge__fill {
    background-color: rgb(255, 176, 32);
}

/* L'arma in mano non può sparare: premere adesso non serve a niente. */

.crosshair.is-blocked .reticle__tick {
    background-color: rgb(255, 77, 77);
}

.crosshair.is-blocked .reticle__dot {
    background-color: rgb(255, 77, 77);
}

.crosshair.is-blocked .reticle__ring {
    border-color: rgb(255, 77, 77);
}

/* ---------- gli avvisi d'impatto ---------- */

/*
 * Un marcatore per ogni asteroide che sta per colpire. Ci sono sempre tutti:
 * il codice sposta quelli che servono e accende is-visible, e a farli comparire
 * è questa regola. Nessun colore e nessuna misura passano dal C#.
 *
 * Ambra come la carica del cannone finché c'è tempo, rossa sotto il
 * secondo: è la stessa scala di gravità delle barre, detta addosso al bersaglio.
 */

.threats {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/*
 * Il codice scrive left e top; il translate porta il centro del riquadro sul
 * punto, così il marcatore sta addosso all'asteroide e non di fianco.
 */
.threat {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
    translate: -50% -50%;
    display: none;
}

.threat.is-visible {
    display: flex;
}

/* ---------- le parti di un marcatore ---------- */

/*
 * Quattro angoli e non un riquadro chiuso: un bordo intero coprirebbe la sagoma
 * dell'asteroide, che è la cosa a cui bisogna sparare.
 */
.threat__corner {
    position: absolute;
    width: 11px;
    height: 11px;
    border-color: rgb(255, 176, 32);
}

.threat__corner--tl {
    left: 0;
    top: 0;
    border-left-width: 2px;
    border-top-width: 2px;
}

.threat__corner--tr {
    right: 0;
    top: 0;
    border-right-width: 2px;
    border-top-width: 2px;
}

.threat__corner--bl {
    left: 0;
    bottom: 0;
    border-left-width: 2px;
    border-bottom-width: 2px;
}

.threat__corner--br {
    right: 0;
    bottom: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

/* Il conto alla rovescia sta sotto il riquadro, centrato sullo stesso punto. */
.threat__timer {
    position: absolute;
    left: 50%;
    top: 100%;
    translate: -50% 3px;
    color: rgb(255, 176, 32);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Sotto il secondo non c'è più tempo per scegliere: allarme. */

.threat.is-imminent .threat__corner {
    border-color: rgb(255, 77, 77);
}

.threat.is-imminent .threat__timer {
    color: rgb(255, 77, 77);
}

/* ---------- le notifiche ---------- */

/*
 * In basso al centro, staccata dal bordo. Entra dal basso con un piccolo
 * rimbalzo ed esce in dissolvenza: il codice accende e spegne is-shown, il
 * movimento è tutto qui.
 */
.notice {
    position: absolute;
    left: 50%;
    bottom: 16%;
    translate: -50% 18px;
    scale: 0.85 0.85;
    opacity: 0;
    padding: 6px 18px 7px 14px;
    background-color: rgba(2, 18, 8, 0.62);
    border-left-width: 2px;
    border-left-color: rgba(74, 222, 128, 0.75);
    color: rgb(74, 222, 128);
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: opacity, translate, scale;
    transition-duration: 0.25s, 0.35s, 0.35s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back;
}

.notice.is-shown {
    translate: -50% 0;
    scale: 1 1;
    opacity: 1;
}
