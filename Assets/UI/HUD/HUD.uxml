<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Terminal.uss" />
    <Style src="project://database/Assets/UI/HUD/HUD.uss" />

    <ui:VisualElement name="hud-root" class="hud" picking-mode="Ignore">

        <!--
            I dati della partita, divisi per quanto spesso si guardano invece
            che raccolti in un blocco solo: quello che si consulta sta negli
            angoli alti, quello che si deve vedere senza leggere sta in basso a
            sinistra, e quello che si usa mentre si spara sta addosso al mirino.

            I segmenti ci sono sempre tutti, come i marcatori d'impatto: il
            codice ne accende quanti gliene servono. Quanti siano lo dice questo
            file — cambiare i punti di scafo vuol dire aggiungere un blocco qui.
        -->
        <ui:VisualElement name="panel-score" class="terminal panel panel--score" picking-mode="Ignore">
            <ui:Label class="terminal__header" text="&gt; SHIP TERMINAL // ONLINE" />
            <ui:VisualElement class="row">
                <ui:Label class="row__key" text="&gt; SCORE" />
                <ui:Label name="value-score" class="row__value" text="0" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="panel-time" class="terminal panel panel--time" picking-mode="Ignore">
            <ui:Label class="panel__label" text="MISSION TIME" />
            <ui:Label name="value-time" class="panel__value" text="00:00" />
        </ui:VisualElement>

        <ui:VisualElement name="panel-difficulty" class="terminal panel panel--difficulty" picking-mode="Ignore">
            <ui:Label class="panel__label" text="DIFFICULTY" />
            <ui:VisualElement class="gauge-row">
                <ui:VisualElement name="pips-difficulty" class="pips">
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                </ui:VisualElement>
                <ui:Label name="value-level" class="panel__value panel__value--inline" text="1/5" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="panel-integrity" class="terminal panel panel--integrity" picking-mode="Ignore">
            <ui:Label class="panel__label" text="SHIP INTEGRITY" />
            <ui:VisualElement class="gauge-row">
                <ui:VisualElement name="pips-integrity" class="pips">
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                    <ui:VisualElement class="pip" />
                </ui:VisualElement>
                <ui:Label name="value-integrity" class="panel__value panel__value--inline" text="5/5" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!--
            Gli avvisi d'impatto: chi sta per colpire la navicella, inseguito a
            schermo, con i secondi che mancano.

            I marcatori ci sono sempre tutti, come i due reticoli qui sotto: il
            codice ne accende quanti gliene servono e spegne gli altri, e a
            mostrarli è l'USS. Quanti siano lo decide questo file e nessun altro
            — Logics li conta all'aggancio. Aggiungerne uno vuol dire copiare un
            blocco qui, e basta.

            Stanno prima del mirino perché il mirino deve restare sopra: quello
            si guarda sempre, questi arrivano e passano.
        -->
        <ui:VisualElement name="threats" class="threats" picking-mode="Ignore">

            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>
            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>
            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>
            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>
            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>
            <ui:VisualElement class="threat" picking-mode="Ignore">
                <ui:VisualElement class="threat__corner threat__corner--tl" />
                <ui:VisualElement class="threat__corner threat__corner--tr" />
                <ui:VisualElement class="threat__corner threat__corner--bl" />
                <ui:VisualElement class="threat__corner threat__corner--br" />
                <ui:Label class="threat__timer" text="0.0" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!--
            Il mirino: sostituisce il cursore e sta dove finisce il colpo.
            Questo elemento è il punto di mira e basta — è l'unico che Logics
            sposta. Il disegno sta nei due reticoli qui dentro, e quale dei due
            si accenda lo decide l'USS a partire dalla classe dell'arma.
        -->
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore">

            <!-- Mitraglietta: leggero e stretto, si spara a raffica. -->
            <ui:VisualElement class="reticle reticle--machinegun">
                <ui:VisualElement class="reticle__tick reticle__tick--top" />
                <ui:VisualElement class="reticle__tick reticle__tick--bottom" />
                <ui:VisualElement class="reticle__tick reticle__tick--left" />
                <ui:VisualElement class="reticle__tick reticle__tick--right" />
                <ui:VisualElement class="reticle__dot" />
            </ui:VisualElement>

            <!-- Cannone: anello e tacche esterne, il colpo va piazzato. -->
            <ui:VisualElement class="reticle reticle--cannon">
                <ui:VisualElement class="reticle__ring" />
                <ui:VisualElement class="reticle__tick reticle__tick--top" />
                <ui:VisualElement class="reticle__tick reticle__tick--bottom" />
                <ui:VisualElement class="reticle__tick reticle__tick--left" />
                <ui:VisualElement class="reticle__tick reticle__tick--right" />
                <ui:VisualElement class="reticle__dot" />
            </ui:VisualElement>

            <!--
                Le due barre dell'arma, ai lati del mirino perché lo sguardo sta
                lì: a sinistra il calore della mitraglietta, a destra la carica
                del cannone. Compaiono solo quando hanno qualcosa da dire.
            -->
            <ui:VisualElement name="gauge-heat" class="gauge gauge--heat">
                <ui:VisualElement name="fill-heat" class="gauge__fill" />
            </ui:VisualElement>

            <ui:VisualElement name="gauge-charge" class="gauge gauge--charge">
                <ui:VisualElement name="fill-charge" class="gauge__fill" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!--
            Le notifiche: un fatto appena successo, detto una volta e poi via.
            Il testo lo scrive Logics, l'entrata e l'uscita le fa l'USS.
        -->
        <ui:Label name="notice" class="notice" text="&gt; CANNON READY" />

    </ui:VisualElement>
</ui:UXML>
